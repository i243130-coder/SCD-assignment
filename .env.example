# Database
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse_dev_password
POSTGRES_DB=civicpulse
DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse_dev_password@postgres:5432/civicpulse

# Redis
REDIS_URL=redis://redis:6379/0

# Triage Provider: simulated | rules | llm | ollama
TRIAGE_PROVIDER=simulated

# Groq (LLM provider) - get free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Tracing (OpenTelemetry) - leave empty to disable. In Kubernetes the dev and
# gitops overlays point this at Jaeger in k8s/observability.
OTEL_EXPORTER_OTLP_ENDPOINT=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development

# Docker image tag (used in compose.prod.yaml)
IMAGE_TAG=latest
